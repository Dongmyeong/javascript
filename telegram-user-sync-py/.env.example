# From https://my.telegram.org -> "API development tools"
API_ID=
API_HASH=

# The bot the Mac receiver listens on. Sending here as YOUR account makes the
# files look like manual uploads, so the receiver's getUpdates poller sees them.
TARGET=@pe_uploader_bot

# Folder(s) to watch. One folder, or a comma-separated list — e.g. to also
# collect KakaoTalk chat exports (.txt), add the folder you save them to:
#   WATCH_DIR=/storage/emulated/0/Recordings,/storage/emulated/0/Download/KakaoTalk
WATCH_DIR=/storage/emulated/0/Recordings
WATCH_RECURSIVE=true

# ---- optional (defaults shown) ----
# Add .txt here too if you collect KakaoTalk "대화 내보내기" text files:
#   WATCH_EXTENSIONS=.m4a,.mp3,.amr,.aac,.wav,.ogg,.opus,.3gp,.txt
# WATCH_EXTENSIONS=.m4a,.mp3,.amr,.aac,.wav,.ogg,.opus,.3gp
# POLL_INTERVAL_MS=5000
# STABLE_FOR_MS=10000
# Split anything bigger than this so the receiving bot can download each part
# (bot getFile limit is 20MB). 19000000 bytes ~= 18MB.
# MAX_PART_BYTES=19000000
# STATE_FILE=.sent-state.json

# How many times to retry a failed send (transient Telegram/network errors)
# before giving up and alerting. FloodWait is always waited out separately.
# MAX_RETRIES=4

# Send alerts (transient failures) and a daily summary to your own Telegram
# "Saved Messages". Turn off to stay silent.
# NOTIFY=true
# Also send a short "started" ping to Saved Messages on launch.
# NOTIFY_START=false
