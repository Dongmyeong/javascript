# From https://my.telegram.org -> "API development tools"
API_ID=
API_HASH=

# The bot the Mac receiver listens on. Sending here as YOUR account makes the
# files look like manual uploads, so the receiver's getUpdates poller sees them.
TARGET=@pe_uploader_bot

# Folder to watch for recordings.
WATCH_DIR=/storage/emulated/0/Recordings
WATCH_RECURSIVE=true

# ---- optional (defaults shown) ----
# WATCH_EXTENSIONS=.m4a,.mp3,.amr,.aac,.wav,.ogg,.opus,.3gp
# POLL_INTERVAL_MS=5000
# STABLE_FOR_MS=10000
# Split anything bigger than this so the receiving bot can download each part
# (bot getFile limit is 20MB). 19000000 bytes ~= 18MB.
# MAX_PART_BYTES=19000000
# STATE_FILE=.sent-state.json
