# ---- Required ----

# From @BotFather (looks like 123456789:ABCdef...).
TELEGRAM_BOT_TOKEN=

# Where to send files. Easiest: send your bot a message, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_CHAT_ID=

# Folder to watch for recordings. Examples on Android/Termux:
#   Call recordings: /storage/emulated/0/Recordings
#   Voice recorder:  /storage/emulated/0/Sounds
#   Samsung calls:   /storage/emulated/0/Call
WATCH_DIR=/storage/emulated/0/Recordings

# ---- Optional (defaults shown) ----

# Comma-separated file extensions to send.
# WATCH_EXTENSIONS=.m4a,.mp3,.amr,.aac,.wav,.ogg,.opus,.3gp

# Also scan subfolders of WATCH_DIR.
# WATCH_RECURSIVE=false

# How often to scan the folder (milliseconds).
# POLL_INTERVAL_MS=5000

# A file must be unchanged for this long before sending (avoids uploading a
# recording that is still in progress).
# STABLE_FOR_MS=10000

# Send as a playable audio message instead of a document/file.
# SEND_AS_AUDIO=false

# Delete each file after it has been successfully sent.
# DELETE_AFTER_SEND=false

# Caption template. Placeholders: {name} {size} {date}
# CAPTION_TEMPLATE=🎙 {name} ({size})

# Where to store the "already sent" record.
# STATE_FILE=.sent-state.json
