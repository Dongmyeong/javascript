# Bot token (same bot the phone sends to). From @BotFather.
TELEGRAM_BOT_TOKEN=

# Where to save received recordings (the transcription pipeline's inbox).
OUTPUT_DIR=/Users/donoh/.openclaw/media/inbound

# --- optional ---
# Where the last processed update id is stored (default <OUTPUT_DIR>/.telegram-offset)
# OFFSET_FILE=/Users/donoh/.openclaw/media/inbound/.telegram-offset

# How long Telegram holds each long-poll request (seconds).
# POLL_TIMEOUT_SEC=30

# A downloaded part must be unchanged this long before reassembly (ms).
# STABLE_FOR_MS=5000
